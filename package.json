{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "image-redacter",
  "title": "Image Redacter",
  "description": "Redact sensitive text and regions in images without changing the original",
  "icon": "icon.png",
  "author": "byronrode",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Design Tools",
    "Security"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "redact-image",
      "title": "Redact Image",
      "description": "Redact a selected image in a private canvas editor",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build -e dist -o dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@raycast/api": "^2.0.5",
    "@raycast/utils": "^2.3.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
